# ---- Secrets / config ----
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Used to verify inbound webhook signatures (you choose this value,
# and send the same value when you simulate a webhook sender)
WEBHOOK_SECRET=change-this-too

# Local dev only — in docker-compose these get overridden
DATABASE_URL=postgresql+psycopg://incident_user:incident_pass@localhost:5432/incident_db
REDIS_URL=redis://localhost:6379/0
